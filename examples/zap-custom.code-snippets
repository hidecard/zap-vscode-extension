{
  "API function": {
    "scope": "zap",
    "prefix": "api_fn",
    "body": [
      "fn ${1:name}(${2:request}: ${3:any}) -> ${4:result}:",
      "    ${5:let response = http_request(${2:request})}",
      "    ${0:say(response)}"
    ],
    "description": "Project-specific API function template"
  },
  "Async worker": {
    "scope": "zap",
    "prefix": "worker",
    "body": [
      "async fn ${1:worker}(${2:input}: ${3:any}) -> Future:",
      "    let ${4:result} = await ${5:operation}(${2:input})",
      "    ${0:ok(${4:result})}"
    ],
    "description": "Project-specific asynchronous worker template"
  },
  "Test case": {
    "scope": "zap",
    "prefix": "test_fn",
    "body": [
      "fn test_${1:name}() -> none:",
      "    let ${2:actual} = ${3:expression}",
      "    assert ${2:actual} == ${4:expected}, ${0:\"test failed\"}"
    ],
    "description": "Project-specific test function template"
  },
  "Logging block": {
    "scope": "zap",
    "prefix": "log_block",
    "body": [
      "say ${1:\"[INFO]\"}",
      "say ${2:value}",
      "${0}"
    ],
    "description": "Simple Zap logging output using the canonical say statement"
  }
}

