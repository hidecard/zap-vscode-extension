{
  "name": "zap-language-support",
  "displayName": "Zap Syntax and LSP",
  "description": "Stable Zap language support for VS Code with canonical say syntax, rich snippets, async completion, quick fixes, formatting, diagnostics, and native Zap LSP workflows.",
  "version": "1.0.0",
  "publisher": "ArkarYan",
  "license": "MIT",
  "icon": "icons/zap-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidecard/zap-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/hidecard/zap-vscode-extension/issues"
  },
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "zap",
    "zap-language",
    "zp",
    "language-server"
  ],
  "activationEvents": [
    "onLanguage:zap",
    "onCommand:zap.runFile",
    "onCommand:zap.checkWorkspace",
    "onCommand:zap.restartDiagnostics",
    "onCommand:zap.restartLanguageServer",
    "onCommand:zap.formatFile",
    "onCommand:zap.lintFile",
    "onCommand:zap.buildWorkspace",
    "onCommand:zap.testWorkspace"
  ],
  "main": "extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zap",
        "aliases": [
          "Zap",
          "zap"
        ],
        "extensions": [
          ".zp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zap",
        "scopeName": "source.zap",
        "path": "./syntaxes/zap.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zap",
        "path": "./snippets/zap.json"
      }
    ],
    "iconThemes": [
      {
        "id": "zap-file-icon-theme",
        "label": "Zap File Icons",
        "path": "./icons/zap-file-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "zap.runFile",
        "title": "Zap: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "zap.checkWorkspace",
        "title": "Zap: Check Workspace",
        "icon": "$(check)"
      },
      {
        "command": "zap.restartDiagnostics",
        "title": "Zap: Restart Diagnostics",
        "icon": "$(refresh)"
      },
      {
        "command": "zap.restartLanguageServer",
        "title": "Zap: Restart Language Server",
        "icon": "$(sync)"
      },
      {
        "command": "zap.formatFile",
        "title": "Zap: Format Current File",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "zap.lintFile",
        "title": "Zap: Lint Current File",
        "icon": "$(check-all)"
      },
      {
        "command": "zap.buildWorkspace",
        "title": "Zap: Build Workspace",
        "icon": "$(tools)"
      },
      {
        "command": "zap.testWorkspace",
        "title": "Zap: Test Workspace",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zap.runFile",
          "when": "editorLangId == zap",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "zap.runFile",
          "when": "editorLangId == zap",
          "group": "zap@1"
        }
      ],
      "commandPalette": [
        {
          "command": "zap.runFile"
        },
        {
          "command": "zap.checkWorkspace"
        },
        {
          "command": "zap.restartDiagnostics"
        },
        {
          "command": "zap.restartLanguageServer"
        },
        {
          "command": "zap.formatFile"
        },
        {
          "command": "zap.lintFile"
        },
        {
          "command": "zap.buildWorkspace"
        },
        {
          "command": "zap.testWorkspace"
        }
      ]
    },
    "configuration": {
      "title": "Zap",
      "properties": {
        "zap.executable": {
          "type": "string",
          "default": "zap",
          "description": "Path or command name for the Zap CLI executable."
        },
        "zap.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Launch the Zap stdio language server for completion, signature help, hover, definitions, formatting, symbols, and diagnostics."
        },
        "zap.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Run `zap check --json` and show diagnostics for the active workspace."
        },
        "zap.diagnosticDelay": {
          "type": "number",
          "default": 350,
          "minimum": 100,
          "maximum": 3000,
          "description": "Delay in milliseconds before checking a changed Zap file."
        },
        "zap.runInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Run Zap files in the integrated terminal instead of an output channel."
        },
        "zap.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run `zap fmt` automatically when saving a Zap file."
        },
        "zap.lspRequestTimeout": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Maximum time in milliseconds to wait for a Zap LSP request."
        }
      }
    }
  },
  "scripts": {
    "test": "node scripts/test-extension.js",
    "package": "vsce package --out dist/$npm_package_name-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
